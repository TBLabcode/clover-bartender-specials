# --- Clover ---
# Sandbox base URL (switch to production URL later — see README)
CLOVER_BASE_URL=https://apisandbox.dev.clover.com
CLOVER_MERCHANT_ID=your_merchant_id_here
CLOVER_API_TOKEN=your_merchant_specific_test_api_token_here

# --- Twilio ---
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid_here

# Separate Messaging Service for shift-coverage texts — its own phone number
# and its own A2P campaign, registered separately from the one above because
# an already-VERIFIED campaign can't be edited to add a new message type.
TWILIO_SHIFT_MESSAGING_SERVICE_SID=your_shift_messaging_service_sid_here

# Phone numbers that are allowed to approve specials (comma separated, E.164 format e.g. +19105551234)
APPROVER_PHONE_NUMBERS=+19105551111,+19105552222

# --- App settings ---
# Port the server runs on
PORT=3000

# Master/recovery passcode — used once to bootstrap the first owner account
# at /admin/master-login, and as a fallback if every owner gets locked out.
# Day-to-day, each owner signs in with their own phone + passcode instead
# (added via /admin/owners once you're in). Pick your own value.
OWNER_PASSCODE=change_me

# Time zone used for the 3am revert and daily report jobs (IANA format)
APP_TIMEZONE=America/New_York

# Set either to "true" to test that part of the flow without hitting the
# real API. CLOVER_DRY_RUN returns fake mock items and logs what would have
# changed. TWILIO_DRY_RUN just logs the text that would have been sent.
# Set both to "false" for real use.
CLOVER_DRY_RUN=false
TWILIO_DRY_RUN=false

# --- Facebook / Instagram (Meta Graph API) ---
# Facebook Page ID for the business page, and a long-lived Page Access Token
# with pages_manage_posts + pages_read_engagement + instagram_basic +
# instagram_content_publish permissions. Generate both via developers.facebook.com
# (Meta App > Graph API Explorer / Access Token Tool).
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here

# Instagram Business/Creator account ID linked to the Facebook Page above
# (find via GET /{FB_PAGE_ID}?fields=instagram_business_account in Graph API Explorer)
IG_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Logs what would be posted instead of actually calling the Graph API.
# Set to "false" once FB_PAGE_ID / FB_PAGE_ACCESS_TOKEN / IG_BUSINESS_ACCOUNT_ID are real.
SOCIAL_DRY_RUN=true

# --- Receipt scanning (owner adds inventory from a photo) ---
# API key for Claude (console.anthropic.com), used to read line items off a
# photographed receipt.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Logs the mock extracted line items instead of calling the Claude API.
# Set to "false" once ANTHROPIC_API_KEY is real.
RECEIPT_DRY_RUN=true
