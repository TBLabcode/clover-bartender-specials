# --- Clover ---
# Sandbox base URL (switch to production URL later — see README)
CLOVER_BASE_URL=https://apisandbox.dev.clover.com
CLOVER_MERCHANT_ID=your_merchant_id_here
CLOVER_API_TOKEN=your_merchant_specific_test_api_token_here

# --- Twilio ---
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid_here

# Phone numbers that are allowed to approve specials (comma separated, E.164 format e.g. +19105551234)
APPROVER_PHONE_NUMBERS=+19105551111,+19105552222

# --- App settings ---
# Port the server runs on
PORT=3000

# Master/recovery passcode — used once to bootstrap the first owner account
# at /admin/master-login, and as a fallback if every owner gets locked out.
# Day-to-day, each owner signs in with their own phone + passcode instead
# (added via /admin/owners once you're in). Pick your own value.
OWNER_PASSCODE=change_me

# Time zone used for the 3am revert and daily report jobs (IANA format)
APP_TIMEZONE=America/New_York

# Set either to "true" to test that part of the flow without hitting the
# real API. CLOVER_DRY_RUN returns fake mock items and logs what would have
# changed. TWILIO_DRY_RUN just logs the text that would have been sent.
# Set both to "false" for real use.
CLOVER_DRY_RUN=false
TWILIO_DRY_RUN=false
